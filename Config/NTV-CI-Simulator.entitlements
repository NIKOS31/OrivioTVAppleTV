<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- Simulator-only ad-hoc identity for the real Keychain integration test.
         No Apple account, provisioning profile, or device entitlement is used. -->
    <key>application-identifier</key><string>NTVCI.com.ntv.simulator</string>
    <key>keychain-access-groups</key><array><string>NTVCI.com.ntv.simulator</string></array>
</dict></plist>
