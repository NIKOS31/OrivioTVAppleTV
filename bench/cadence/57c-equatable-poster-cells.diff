+/// The row's current callbacks, behind one stable reference. Not observable:
+/// refreshing it never invalidates a view, it only changes what a later
+/// press or focus change calls.
+@MainActor
+private final class HomePosterCellActions {
+    private(set) var onSelect: (MetaItem) -> Void = { _ in }
+    private(set) var onPlayManually: (MetaItem, MetaVideo?) -> Void = { _, _ in }
+    private(set) var onVerticalMove: ((MoveCommandDirection) -> Void)?
+    private(set) var onFocusChanged: (String, Bool) -> Void = { _, _ in }
+
+    func refresh(onSelect: @escaping (MetaItem) -> Void,
+                 onPlayManually: @escaping (MetaItem, MetaVideo?) -> Void,
+                 onVerticalMove: ((MoveCommandDirection) -> Void)?,
+                 onFocusChanged: @escaping (String, Bool) -> Void) {
+        self.onSelect = onSelect
+        self.onPlayManually = onPlayManually
+        self.onVerticalMove = onVerticalMove
+        self.onFocusChanged = onFocusChanged
+    }
+}
